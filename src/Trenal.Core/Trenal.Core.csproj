<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral PowerShell host: key parsing, line editor, PSHost over a VT terminal.
       Runs unchanged on iOS (Mono interpreter) and on desktop (Trenal.Cli, used for tests). -->
  <PropertyGroup>
    <!-- net8.0 exists only so CI can run the selftest on desktop Mono in interpreter-only mode:
         .NET 10 no longer ships a desktop Mono runtime pack, iOS still runs on Mono. -->
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PowerShellSdkVersion>7.4.*</PowerShellSdkVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="$(PowerShellSdkVersion)" />
    <!-- ssh/scp/ssh-keygen in-process (pure managed; BouncyCastle for ed25519). -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- git via libgit2. Desktop gets native binaries from NuGet; iOS builds the same libgit2
         commit in native/build-libgit2-ios.sh (see LibGit2Sharp.NativeBinaries' libgit2_hash). -->
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <EmbeddedResource Include="startup.ps1" LogicalName="Trenal.startup.ps1" />
    <!-- trenal's own modules (unix shims...). Hosts put <output>/Modules on PSModulePath;
         the iOS app bundles the same files. -->
    <Content Include="Modules/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
